# Скопируйте в .env и задайте значения. Не коммитьте .env с секретами.

# development | production
IPSAS_ENV=development
FLASK_ENV=development
# В production обязательно:
# SECRET_KEY=replace-with-long-random-string
SECRET_KEY=

LOG_LEVEL=INFO
LOG_TO_FILE=true
# FLASK_DEBUG только для локальной разработки (в production запрещён)
FLASK_DEBUG=false

# Каталоги (по умолчанию — относительно корня репозитория)
# TEMP_DIR=/var/lib/ipsas/temp
# DATA_DIR=/var/lib/ipsas/data
# LOGS_DIR=/var/log/ipsas
# SCHEMAS_DIR=/app/schemas

MAX_CONTENT_LENGTH=10485760
MAX_FILE_SIZE=10485760
TEMP_FILE_TTL_SECONDS=21600

# Исходящие HTTP
REQUEST_TIMEOUT=30
REQUEST_MAX_RETRIES=3
# Production: обязательно (через запятую), напр. journals.rcsi.science
# ISSUE_FETCH_ALLOWED_HOSTS=journals.rcsi.science
ISSUE_FETCH_ALLOWED_HOSTS=

MAX_CONCURRENT_JOBS=4
MAX_JOB_QUEUE=8
RATE_LIMIT_PER_MINUTE=30

# Запись ENG-метаданных в OJS (по умолчанию выкл. — только локальный dry-run)
PLATFORM_APPLY_ENABLED=0
# PLATFORM_BASE_URL=https://journals.rcsi.science
# PLATFORM_USERNAME=
# PLATFORM_PASSWORD=
# или RCSI_USERNAME= / RCSI_PASSWORD=
# PLATFORM_COOKIE_FILE=
# PLATFORM_REQUEST_DELAY=0.35
# Для production также укажите ISSUE_FETCH_ALLOWED_HOSTS=journals.rcsi.science

# Песочница (базовая настройка ветки журнала). Ворота = HTTP Basic Auth; OJS = signIn.
# SANDBOX_BASE_URL=https://f23g45.rcsi.science
# SANDBOX_GATE_USERNAME=   # или SANDBOX_USER1_USERNAME
# SANDBOX_GATE_PASSWORD=   # или SANDBOX_USER1_PASSWORD
# SANDBOX_OJS_USERNAME=    # или SANDBOX_USER2_USERNAME
# SANDBOX_OJS_PASSWORD=    # или SANDBOX_USER2_PASSWORD
# SANDBOX_COOKIE_FILE=
# SANDBOX_REQUEST_DELAY=0.35
# В ISSUE_FETCH_ALLOWED_HOSTS добавьте f23g45.rcsi.science

# Cookie: в production Secure=true по умолчанию — не копируйте false в prod.
# SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
# Включайте только за доверенным reverse-proxy
TRUST_PROXY_HEADERS=false

# Gunicorn (один worker: in-memory rate limit)
GUNICORN_WORKERS=1
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100
PORT=5000
