# Скопируйте в .env и задайте значения. Не коммитьте .env с секретами.

# development | production
IPSAS_ENV=development
FLASK_ENV=development
# В production обязательно:
# SECRET_KEY=replace-with-long-random-string
SECRET_KEY=

LOG_LEVEL=INFO
LOG_TO_FILE=true
# FLASK_DEBUG только для локальной разработки (в production запрещён)
FLASK_DEBUG=false

# Каталоги (по умолчанию — относительно корня репозитория)
# TEMP_DIR=/var/lib/ipsas/temp
# DATA_DIR=/var/lib/ipsas/data
# LOGS_DIR=/var/log/ipsas
# SCHEMAS_DIR=/app/schemas

MAX_CONTENT_LENGTH=10485760
MAX_FILE_SIZE=10485760
TEMP_FILE_TTL_SECONDS=21600

# Исходящие HTTP
REQUEST_TIMEOUT=30
REQUEST_MAX_RETRIES=3
# Через запятую; пусто = любые публичные хосты после SSRF-проверок
ISSUE_FETCH_ALLOWED_HOSTS=
# EDITORIAL_BOARD_URL=https://example.example/editorial

MAX_CONCURRENT_JOBS=4
RATE_LIMIT_PER_MINUTE=30

# Cookie (в production за HTTPS Secure=true по умолчанию)
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
# Включайте только за доверенным reverse-proxy
TRUST_PROXY_HEADERS=false

# Gunicorn (один worker: in-memory rate limit)
GUNICORN_WORKERS=1
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
PORT=5000
