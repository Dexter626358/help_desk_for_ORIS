# Настройки приложения для production.
#
# Сюда попадают только настройки приложения. Порты, пути и число воркеров
# НЕ задаются здесь: их выставляет способ запуска, потому что значения
# разные и несовместимые.
#
#   systemd + nginx:  deploy/ipsas.service.example   (GUNICORN_BIND=127.0.0.1:8000)
#   Docker Compose:   docker-compose.yml            (GUNICORN_BIND=0.0.0.0:8000)
#
# Если задать GUNICORN_BIND=127.0.0.1 здесь и запустить в Docker,
# gunicorn будет слушать только внутри контейнера, проброс порта перестанет
# соединяться, и nginx отдаст 502 Bad Gateway.
#
# Как использовать (Docker Compose, основной вариант):
#   1. cp deploy/ipsas.env.production.example .env
#   2. вписать SECRET_KEY и ISSUE_FETCH_ALLOWED_HOSTS
#   3. chmod 600 .env
#   4. docker compose up -d --build
#
# Как использовать (systemd):
#   1. sudo mkdir -p /etc/ipsas
#   2. sudo cp deploy/ipsas.env.production.example /etc/ipsas/ipsas.env
#   3. заполнить значения, sudo chmod 600 /etc/ipsas/ipsas.env
#   4. sudo systemctl restart ipsas
#
# Реальные секреты в репозиторий НЕ коммитятся (.env в .gitignore).

# --- Обязательное -----------------------------------------------------------

# Секрет сессий и CSRF. Без него приложение не стартует.
# Сгенерировать: openssl rand -hex 32
SECRET_KEY=

# production | prod
IPSAS_ENV=production
FLASK_ENV=production

# Разрешённые внешние хосты через запятую (защита от SSRF).
# Без неё приложение не стартует. Сюда же добавить хост Платформы и песочницы,
# если используются парсер выпуска / архивация / настройка в песочнице.
# Пример: journals.rcsi.science,f23g45.rcsi.science
ISSUE_FETCH_ALLOWED_HOSTS=journals.rcsi.science

# Обязательно должен быть false: иначе приложение не стартует.
FLASK_DEBUG=false

# --- Логи --------------------------------------------------------------------

# В systemd логи уходят в journalctl, в Docker - в docker logs,
# поэтому файл не нужен ни там, ни там.
LOG_TO_FILE=false
LOG_LEVEL=INFO

# --- Reverse proxy -----------------------------------------------------------

# Прокси (nginx) — единственный, кто обращается к приложению по 127.0.0.1.
# Включать ТОЛЬКО при закрытом 127.0.0.1:8000. Без этого все пользователи
# попадут в один rate-limit (30 запросов/мин на всех).
TRUST_PROXY_HEADERS=true

# --- Cookie / сессии ---------------------------------------------------------
#
# В production cookie по умолчанию помечается Secure. Сервис открыт по
# обычному http:// (без TLS), поэтому Secure приходится выключить: иначе
# браузер не примет cookie, и все POST-формы будут отбиваться ошибкой CSRF.
#
# Как только появится HTTPS - верните true. Cookie по http:// передаётся
# открытым текстом, поэтому решение временное.

SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax

# --- Лимиты -----------------------------------------------------------------

# Максимальный размер загружаемого файла: 10 МБ. Должно совпадать или быть
# больше client_max_body_size в nginx (там 12m).
MAX_CONTENT_LENGTH=10485760
MAX_FILE_SIZE=10485760
TEMP_FILE_TTL_SECONDS=21600
MAX_CONCURRENT_JOBS=4
MAX_JOB_QUEUE=8
RATE_LIMIT_PER_MINUTE=30
REQUEST_TIMEOUT=30
REQUEST_MAX_RETRIES=3

# --- Запись на Платформу (OJS) ----------------------------------------------
#
# По умолчанию все операции записи выключены и работают в режиме dry-run:
# сервис только показывает, что он СОБИРАЕТСЯ сделать. Включайте
# осознанно и только вместе с учётными данными и allowlist выше.

PLATFORM_APPLY_ENABLED=0
PLATFORM_BASE_URL=https://journals.rcsi.science
# PLATFORM_USERNAME=
# PLATFORM_PASSWORD=
# Допустимо также RCSI_USERNAME / RCSI_PASSWORD
# PLATFORM_COOKIE_FILE=
PLATFORM_REQUEST_DELAY=0.35

# --- Песочница (базовая настройка журнала) ----------------------------------
#
# Нужна только для сервиса «Настройка в песочнице»
# (/services/sandbox-journal-setup). Хост песочницы должен быть
# в ISSUE_FETCH_ALLOWED_HOSTS выше.

# SANDBOX_BASE_URL=https://f23g45.rcsi.science
# SANDBOX_GATE_USERNAME=
# SANDBOX_GATE_PASSWORD=
# SANDBOX_OJS_USERNAME=
# SANDBOX_OJS_PASSWORD=
# SANDBOX_COOKIE_FILE=
# SANDBOX_REQUEST_DELAY=0.35
