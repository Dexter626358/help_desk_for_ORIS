[Unit]
Description=IPSAS Flask application (Gunicorn)
After=network.target

[Service]
Type=simple
User=ipsas
Group=ipsas
WorkingDirectory=/opt/ipsas
EnvironmentFile=-/etc/ipsas/ipsas.env
Environment=IPSAS_ENV=production
Environment=FLASK_ENV=production
Environment=TEMP_DIR=/var/lib/ipsas/temp
Environment=DATA_DIR=/var/lib/ipsas/data
Environment=LOGS_DIR=/var/log/ipsas
Environment=LOG_TO_FILE=false
Environment=PORT=8000
Environment=GUNICORN_BIND=127.0.0.1:8000
# Один worker: in-memory rate limit (RequestGuard)
ExecStart=/opt/ipsas/.venv/bin/gunicorn -c /opt/ipsas/gunicorn.conf.py ipsas.web.wsgi:app
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=40

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/ipsas /var/log/ipsas

[Install]
WantedBy=multi-user.target
