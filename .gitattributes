# Нормализация переносов строк.
#
# Зачем: без этого git решает по настройке каждой машины. Скрипт .sh с CRLF
# на Linux не запускается (bad interpreter: /bin/bash^M), а nginx и systemd
# не терпят CRLF в конфигурации.

* text=auto

# Скрипты и конфигурация сервера — строго LF.
*.sh text eol=lf
*.conf text eol=lf
*.service text eol=lf
*.example text eol=lf
*.env text eol=lf

# Скрипты Windows.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Python, документация.
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
